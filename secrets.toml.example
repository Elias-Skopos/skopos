# Somente exemplos. Configure os valores reais nos Secrets, nunca no Git.
# No Streamlit Cloud, depois de preservar seus dados, ative a página pública:
# [distribution]
# edition = "public"
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO"

[auth.google]
client_id = "SEU_CLIENT_ID_DO_GOOGLE"
client_secret = "SEU_CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Opcional no PC; necessário para persistência no Streamlit Cloud.
# [database]
# url = "postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

# Opcional: envio dos convites por e-mail. Sem isso, o convite aparece no login.
# Use 587 com STARTTLS ou 465 com TLS; nunca envie este arquivo com valores reais.
# [email]
# host = "smtp.seu-provedor.com"
# port = 587
# username = "seu_usuario_smtp"
# password = "sua_senha_smtp"
# from_email = "convites@sua-empresa.com"
# app_url = "https://seu-app.streamlit.app"
